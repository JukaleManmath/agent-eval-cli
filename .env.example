# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# Required for --mode groq (free API key at https://console.groq.com)
GROQ_API_KEY=

# Injected as ${AGENT_API_KEY} in your YAML request_template.
# Set this to whatever your agent's API key is.
AGENT_API_KEY=
